# Personal API key created in the Fadewright app or via POST /api/v1/api-keys (shown once)
FADEWRIGHT_API_KEY=fwk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Base URL of screenwriter_api (default http://localhost:8036)
FADEWRIGHT_API_URL=http://localhost:8036
# Optional: ceiling on characters per tool result (default 60000)
# FADEWRIGHT_MAX_OUTPUT_CHARS=60000
# Optional: config file instead of env (default ~/.fadewright/config.json)
# FADEWRIGHT_CONFIG_PATH=
